# Copy to .env and fill in. .env is gitignored; never commit real keys.

# One key covers both the agent model and web search.
OPENAI_API_KEY=sk-your-key-here
# Model names are configuration, never code. Each needs an entry in config/prices.toml.
AGENT_MODEL=your-agent-model
SEARCH_MODEL=your-search-model

DATABASE_URL=postgresql+asyncpg://memagent:memagent@localhost:5433/memagent
MAX_STEPS=10

# Optional (defaults shown)
# WORKSPACE_ROOT=data/workspaces
# PRICES_PATH=config/prices.toml
# TEST_DATABASE_URL=postgresql+asyncpg://memagent:memagent@localhost:5433/memagent_test

# Used by `memagent chat`
# MEMAGENT_API_URL=http://127.0.0.1:8000
# MEMAGENT_API_KEY=mk_...
